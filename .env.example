# Firebase Client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=givewithlocus
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (optional — uses ADC by default in App Hosting)
# Set this for local dev if not using `gcloud auth application-default login`
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Locus (platform-level key for wallet registration + wrapped APIs)
LOCUS_PLATFORM_API_KEY=

# Encryption (32-byte hex — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Locus Checkout UI URL (change if beta sessions need beta checkout URL)
NEXT_PUBLIC_LOCUS_CHECKOUT_URL=https://checkout.paywithlocus.com

# Thesys C1 API key (sk-th-... — get from https://console.thesys.dev)
THESYS_API_KEY=
